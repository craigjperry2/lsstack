name: CI

on:
  pull_request:
  push:
    branches:
      - main

permissions:
  contents: read

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

env:
  LITESTAR_APP: app.main:app
  UV_CACHE_DIR: ${{ github.workspace }}/.uv-cache

jobs:
  quality:
    name: Quality (${{ matrix.os }})
    runs-on: ${{ matrix.os }}
    timeout-minutes: 30
    strategy:
      fail-fast: false
      matrix:
        os:
          - ubuntu-24.04
          - macos-15
    steps:
      - name: Check out repository
        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          persist-credentials: false

      - name: Install Nix
        uses: cachix/install-nix-action@8aa03977d8d733052d78f4e008a241fd1dbf36b3 # v31.10.6

      - name: Cache uv downloads
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: .uv-cache
          key: uv-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('uv.lock') }}

      - name: Evaluate flake
        run: nix flake check --all-systems --no-build

      - name: Install locked dependencies
        run: nix develop --command just setup

      - name: Run non-mutating quality gate
        run: nix develop --command just check

      - name: Run prek hook stages
        run: nix develop --command just prek

      - name: Verify hooks made no changes
        run: git diff --exit-code

  integration:
    name: Linux integration
    runs-on: ubuntu-24.04
    timeout-minutes: 40
    env:
      APP_ENV: test
      DEBUG: "false"
      DATABASE_URL: postgresql+psycopg://app_user:app_dev_password@127.0.0.1:5432/lsstack
      ADMIN_DATABASE_URL: postgresql+psycopg://postgres:postgres_dev_password@127.0.0.1:5432/postgres
      TEST_DATABASE_URL: postgresql+psycopg://app_user:app_dev_password@127.0.0.1:5432/lsstack_test
      SAQ_DATABASE_URL: postgresql://saq_user:saq_dev_password@127.0.0.1:5432/lsstack
      RUN_DATABASE_TESTS: "1"
      RUN_SERVICE_TESTS: "1"
      SESSION_SECRET: ci-session-secret-with-at-least-thirty-two-bytes
      CSRF_SECRET: ci-csrf-secret-with-at-least-thirty-two-bytes
      SESSION_COOKIE_SECURE: "false"
      TELEMETRY_ENABLED: "true"
      OTLP_ENDPOINT: http://127.0.0.1:4317
    steps:
      - name: Check out repository
        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          persist-credentials: false

      - name: Install Nix
        uses: cachix/install-nix-action@8aa03977d8d733052d78f4e008a241fd1dbf36b3 # v31.10.6

      - name: Cache uv downloads
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: .uv-cache
          key: uv-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('uv.lock') }}

      - name: Install locked dependencies
        run: nix develop --command just setup

      - name: Validate Compose model
        run: docker compose config --quiet

      - name: Start isolated application stack
        run: nix develop --command just up

      - name: Run integration, performance, and service smoke tests
        run: nix develop --command just test-all

      - name: Verify local observability ingestion
        run: nix develop --command just obs check --timeout 120

      - name: Verify Nginx upstream failure diagnostics
        run: |
          set -a
          . ./.run/stack.env
          set +a
          docker compose exec -T nginx nginx -t
          app_pid=$(nix develop --command python -c \
            'import json; print(json.load(open(".run/processes.json"))["processes"]["app"]["pid"])')
          kill "${app_pid}"
          for attempt in $(seq 1 50); do
            if ! curl --silent --output /dev/null --max-time 1 \
              "http://127.0.0.1:${APP_PORT}/livez"; then
              break
            fi
            if test "${attempt}" = "50"; then
              echo "Host application did not stop before the Nginx probe" >&2
              exit 1
            fi
            sleep 0.1
          done
          status=$(curl --silent --output /dev/null --max-time 10 \
            --write-out '%{http_code}' \
            "http://127.0.0.1:${NGINX_PORT}/__ci_nginx_upstream_failure_probe__")
          test "${status}" = "502"
          nginx_logs=$(docker compose logs --no-color --since 1m nginx)
          case "${nginx_logs}" in
            *"connect() failed"*"/__ci_nginx_upstream_failure_probe__"*) ;;
            *)
              echo "Nginx did not retain the expected upstream connection error" >&2
              echo "${nginx_logs}" >&2
              exit 1
              ;;
          esac

      - name: Capture diagnostics
        if: always()
        run: |
          mkdir -p .ci
          nix develop --command just diagnose >.ci/diagnose.log 2>&1 || true

      - name: Upload failure diagnostics
        if: failure()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: integration-diagnostics
          path: |
            .ci/
            .run/*.log
          if-no-files-found: warn
          retention-days: 7

      - name: Stop host processes and Compose
        if: always()
        run: nix develop --command just down
