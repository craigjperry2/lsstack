user nginx;
worker_processes auto;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    map $http_x_request_id $lsstack_request_id {
        "~^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" $http_x_request_id;
        default $request_id;
    }

    map $uri $lsstack_cache_control {
        "~^/static/" "public, max-age=31536000, immutable";
        default "no-store";
    }

    log_format access_json escape=json
        '{'
          '"timestamp":"$time_iso8601",'
          '"request_id":"$lsstack_request_id",'
          '"remote_addr":"$remote_addr",'
          '"forwarded_for":"$proxy_add_x_forwarded_for",'
          '"method":"$request_method",'
          '"path":"$uri",'
          '"status":$status,'
          '"bytes_sent":$body_bytes_sent,'
          '"request_seconds":$request_time,'
          '"upstream_seconds":"$upstream_response_time",'
          '"upstream_status":"$upstream_status",'
          '"user_agent":"$http_user_agent"'
        '}';

    access_log /var/log/nginx-json/access.json.log access_json;
    # Stock Nginx error logs cannot be JSON-formatted or guaranteed to omit
    # query strings. Retain them on container stderr for local diagnostics,
    # but do not ship them through the structured access-log collector.
    error_log /dev/stderr warn;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 30s;
    server_tokens off;

    gzip on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        application/javascript
        application/json
        application/xml
        image/svg+xml
        text/css
        text/plain;

    client_body_timeout 10s;
    client_header_timeout 10s;
    client_max_body_size 1m;
    large_client_header_buffers 4 16k;
    send_timeout 30s;

    upstream host_application {
        server host.docker.internal:${NGINX_UPSTREAM_PORT};
        keepalive 16;
    }

    server {
        listen 8080;
        server_name localhost 127.0.0.1;

        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'" always;
        add_header Cache-Control $lsstack_cache_control always;
        add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Request-ID $lsstack_request_id always;

        proxy_hide_header Cache-Control;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Request-ID;

        location = /nginx-health {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        location /static/ {
            proxy_pass http://host_application;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Request-ID $lsstack_request_id;
            proxy_connect_timeout 3s;
            proxy_read_timeout 15s;
            proxy_send_timeout 15s;
            proxy_hide_header Cache-Control;
            proxy_hide_header Content-Security-Policy;
            proxy_hide_header Permissions-Policy;
            proxy_hide_header Referrer-Policy;
            proxy_hide_header Set-Cookie;
            proxy_hide_header X-Content-Type-Options;
            proxy_hide_header X-Frame-Options;
            proxy_hide_header X-Request-ID;

        }

        location / {
            proxy_pass http://host_application;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Request-ID $lsstack_request_id;
            proxy_connect_timeout 3s;
            proxy_read_timeout 30s;
            proxy_send_timeout 30s;
        }
    }
}
