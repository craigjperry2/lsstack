# Local development only. Copy this file to .env; never commit .env.
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console

# The Compose superuser is for migrations and disposable test-database setup only.
POSTGRES_DB=lsstack
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
DATABASE_URL=postgresql+psycopg://app_user:app_dev_password@127.0.0.1:5432/lsstack
ADMIN_DATABASE_URL=postgresql+psycopg://postgres:postgres_dev_password@127.0.0.1:5432/postgres
TEST_DATABASE_URL=postgresql+psycopg://app_user:app_dev_password@127.0.0.1:5432/lsstack_test
SAQ_DATABASE_URL=postgresql://saq_user:saq_dev_password@127.0.0.1:5432/lsstack

# These values are deliberately local-only. Generate independent random secrets
# before using this starter anywhere beyond an isolated developer machine.
SESSION_SECRET=local-session-secret-change-me-32-bytes-minimum
CSRF_SECRET=local-csrf-secret-change-me-32-bytes-minimum
SESSION_COOKIE_NAME=lsstack_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_LIFETIME_SECONDS=43200

SQIDS_SALT=local-sqids-salt-change-me
SQIDS_ALPHABET=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789
SQIDS_MIN_LENGTH=8

PUBLIC_BASE_URL=http://localhost:8080
PROXY_BASE_URL=http://host.docker.internal:8000
TRUSTED_HOSTS=localhost,127.0.0.1

# Idempotent local demo data used by `just db-seed`.
DEV_SEED_EMAIL=agent@example.test
DEV_SEED_PASSWORD=correct-horse-battery

TELEMETRY_ENABLED=true
OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_SERVICE_NAME=lsstack

# Litestar CLI entry point used by the README and CI.
LITESTAR_APP=app.main:app
